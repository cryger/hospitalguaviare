# ===== Base de datos (cPanel › Bases de datos MySQL) =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario_hsjgapi
DB_PASSWORD=cambie-esta-clave
DB_NAME=usuario_hsjgportal

# ===== Seguridad =====
# Cadena larga y aleatoria. Genérela con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRA=8h

# Dominios que pueden consumir la API (separados por coma)
CORS_ORIGINS=https://hospitalguaviare.vercel.app,http://localhost:4200

# ===== Archivos =====
# URL pública de la API (se usa para armar las URL de los archivos subidos)
PUBLIC_URL=https://api.esehospitalguaviare.gov.co/api
UPLOAD_DIR=./uploads
# Adjuntos de PQRSFD y solicitudes contractuales (datos personales).
# Debe quedar FUERA de public_html: la API los entrega solo a usuarios autorizados.
PRIVADO_DIR=./privado
MAX_ARCHIVO_MB=20

# Puerto (en cPanel/Passenger lo asigna el servidor; no hace falta)
PORT=3000

# ===== Correo saliente (SMTP) =====
# Cuenta del dominio institucional, ej. en cPanel › Cuentas de correo › Connect Devices
# (servidor de correo saliente, puerto 465 con SSL o 587 con STARTTLS).
SMTP_HOST=mail.esehospitalguaviare.gov.co
SMTP_PORT=465
SMTP_SEGURO=true
SMTP_USUARIO=notificaciones@esehospitalguaviare.gov.co
SMTP_CLAVE=
SMTP_REMITENTE="Portal E.S.E. Hospital San José del Guaviare <notificaciones@esehospitalguaviare.gov.co>"

# ===== Canal anticorrupción (SICOF) =====
# Los reportes del formulario /sicof llegan a este correo
SICOF_CORREO=oficialdecumplimiento@esehospitalguaviare.gov.co
